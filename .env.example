# PostgreSQL connection string used by Prisma when running the app directly
# on your host (npm run dev / prisma migrate). Use "localhost" here — the
# docker-compose.yml builds its own DATABASE_URL from the POSTGRES_* vars
# below, pointing at the "postgres" service hostname instead, so this value
# is never used inside the container.
DATABASE_URL=postgresql://opencal:opencal@localhost:5432/opencal

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# NEVER exposed to the client — only read on the server.
GEMINI_API_KEY=

# Optional: override the Gemini model used for food analysis.
GEMINI_MODEL=gemini-3.5-flash-lite

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Postgres credentials used by the postgres container itself.
POSTGRES_USER=opencal
POSTGRES_PASSWORD=opencal
POSTGRES_DB=opencal
